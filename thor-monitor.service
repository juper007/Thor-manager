[Unit]
Description=Jetson Thor Monitoring Dashboard
After=network.target

[Service]
Type=simple
User=juper007
WorkingDirectory=/home/juper007/thor-monitor
EnvironmentFile=/etc/thor-monitor.env
Environment=THOR_MONITOR_PORT=8090
ExecStart=/usr/bin/python3 /home/juper007/thor-monitor/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
